# Required for operator mutations; generate a strong random value.
ONRECORD_ADMIN_TOKEN=

# Set true on any deployment whose database contains non-public records.
ONRECORD_PROTECT_READS=false

# Enable only on a separate, clean public judge deployment.
ONRECORD_JUDGE_MODE=false

# Optional source/API configuration.
GITHUB_TOKEN=
BASE_RPC_URL=https://mainnet.base.org
BASE_SCAN_BLOCKS=2000

# Optional server-side Base signer. Browser-wallet signing is preferred.
BASE_PRIVATE_KEY=
