{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Scene",
  "description": "Runtime Scene definition for OnRecord",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(repo:[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(#[0-9]+)?|wallet:0x[a-fA-F0-9]{40}(@[0-9]+)?|dune:address:0x[a-fA-F0-9]{40})$"
      }
    },
    "updated": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "sources",
    "updated"
  ],
  "additionalProperties": false
}
